{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CommandProject",
  "version": "0.1.0",
  "identifier": "club.project.commandproject",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CommandProject",
        "width": 1320,
        "height": 840,
        "minWidth": 1040,
        "minHeight": 680,
        "decorations": false,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Project Club",
    "category": "Game",
    "shortDescription": "Launcher e hub de mods do Supreme Commander 2",
    "longDescription": "Gerencie, crie e sincronize mods do Supreme Commander 2.",
    "copyright": "MIT — CommandProject. Supreme Commander 2 é marca registrada de seus respectivos donos.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": {
      "../resources/maptk/*": "maptk/",
      "../resources/python/**/*": "python/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
